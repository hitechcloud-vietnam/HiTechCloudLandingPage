{
  "name": "hitechcloud-landingpage",
  "version": "1.0.0",
  "private": true,
  "description": "HiTechCloud LandingPage - nền tảng SaaS tạo landing page kéo thả (GrapesJS) đa người thuê",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.js\"",
    "backup": "node --disable-warning=ExperimentalWarning scripts/backup.js",
    "e2e": "playwright test -c e2e/playwright.config.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hitechcloud-vietnam/HiTechCloudLandingPage.git"
  },
  "author": "Pho Tue SoftWare Solutions JSC / HiTechCloud-VN",
  "license": "UNLICENSED",
  "dependencies": {
    "express": "^4.22.3",
    "font-awesome": "4.7.0",
    "grapesjs": "0.23.6",
    "grapesjs-blocks-basic": "^1.0.2",
    "grapesjs-plugin-forms": "^2.0.6",
    "nodemailer": "^10.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1"
  }
}
