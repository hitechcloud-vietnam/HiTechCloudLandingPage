PORT=3000
NODE_ENV=production
# URL công khai của dashboard (dùng để kiểm tra Origin chống CSRF)
APP_URL=https://app.hitechcloud.vn
# Tên miền gốc để phục vụ website khách hàng dạng <subdomain>.<PUBLISH_ROOT_DOMAIN>
# Nên dùng tên miền KHÁC với dashboard (vd: hitechcloud.site) để cô lập cookie.
PUBLISH_ROOT_DOMAIN=hitechcloud.site
# Tên máy chủ khách hàng trỏ CNAME tên miền riêng về (xác minh tên miền)
CNAME_TARGET=sites.hitechcloud.site
# docker-compose / Caddy
APP_DOMAIN=app.hitechcloud.vn
ACME_EMAIL=contact@photuesoftware.vn
DB_FILE=/data/hitechcloud.db
UPLOADS_DIR=/data/uploads
# Email quản trị nền tảng (được đổi gói cho workspace), phân tách bằng dấu phẩy
SUPERADMIN_EMAILS=contact@photuesoftware.vn
SESSION_DAYS=30
# Khóa HMAC ký dấu thời gian trong form (chống bot gửi form tự động). Tạo bằng: openssl rand -hex 32
# Để trống: dẫn xuất từ khóa thanh toán/SMTP hoặc tự sinh và lưu cạnh file database.
LEAD_SECRET=

# ---- Cổng thanh toán (để trống nếu không dùng) ----
# payOS: https://my.payos.vn → Kênh thanh toán → Client ID / API Key / Checksum Key
# Webhook cần khai báo: <APP_URL>/api/billing/webhooks/payos
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Pay2S: thông tin tích hợp trong trang quản trị Pay2S
# IPN URL được gửi kèm mỗi giao dịch: <APP_URL>/api/billing/webhooks/pay2s
PAY2S_PARTNER_CODE=
PAY2S_ACCESS_KEY=
PAY2S_SECRET_KEY=
PAY2S_PARTNER_NAME=HiTechCloud
# sandbox | production
PAY2S_ENV=sandbox

# ---- Email (đặt lại mật khẩu, lời mời, biên nhận thanh toán, thông báo lead) ----
# Để trống thì email chỉ được in ra log. Ví dụ: smtps://user:pass@smtp.gmail.com:465
SMTP_URL=
MAIL_FROM=HiTechCloud <no-reply@hitechcloud.vn>
