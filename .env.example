PORT=3000
NODE_ENV=production
# URL công khai của dashboard (dùng để kiểm tra Origin chống CSRF)
APP_URL=https://app.hitechcloud.vn
# Tên miền gốc để phục vụ website khách hàng dạng <subdomain>.<PUBLISH_ROOT_DOMAIN>
# Nên dùng tên miền KHÁC với dashboard (vd: hitechcloud.site) để cô lập cookie.
PUBLISH_ROOT_DOMAIN=hitechcloud.site
# Tên máy chủ khách hàng trỏ CNAME tên miền riêng về (xác minh tên miền)
CNAME_TARGET=sites.hitechcloud.site
# docker-compose / Caddy
APP_DOMAIN=app.hitechcloud.vn
ACME_EMAIL=contact@photuesoftware.vn
DB_FILE=/data/hitechcloud.db
UPLOADS_DIR=/data/uploads
# Email quản trị nền tảng (được đổi gói cho workspace), phân tách bằng dấu phẩy
SUPERADMIN_EMAILS=contact@photuesoftware.vn
SESSION_DAYS=30
# Khóa HMAC ký dấu thời gian trong form (chống bot gửi form tự động). Tạo bằng: openssl rand -hex 32
# Để trống: dẫn xuất từ khóa thanh toán/SMTP hoặc tự sinh và lưu cạnh file database.
LEAD_SECRET=

# Tự động tạm ngưng website khi trang vừa xuất bản có dấu hiệu giả mạo ngân hàng
# (ô mật khẩu + tên ngân hàng/ví điện tử, điểm rủi ro cao). 0 = chỉ gắn cờ chờ quản trị viên xem xét.
SAFETY_AUTO_SUSPEND=1

# ---- Cổng thanh toán (để trống nếu không dùng) ----
# payOS: https://my.payos.vn → Kênh thanh toán → Client ID / API Key / Checksum Key
# Webhook cần khai báo: <APP_URL>/api/billing/webhooks/payos
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Pay2S: thông tin tích hợp trong trang quản trị Pay2S
# IPN URL được gửi kèm mỗi giao dịch: <APP_URL>/api/billing/webhooks/pay2s
PAY2S_PARTNER_CODE=
PAY2S_ACCESS_KEY=
PAY2S_SECRET_KEY=
PAY2S_PARTNER_NAME=HiTechCloud
# sandbox | production
PAY2S_ENV=sandbox

# ---- Email (đặt lại mật khẩu, lời mời, biên nhận thanh toán, thông báo lead) ----
# Để trống thì email chỉ được in ra log. Ví dụ: smtps://user:pass@smtp.gmail.com:465
SMTP_URL=
MAIL_FROM=HiTechCloud <no-reply@hitechcloud.vn>

# ---- Zalo OA (thông báo lead qua tin nhắn tư vấn Zalo Official Account) ----
# Ứng dụng của nền tảng tại https://developers.zalo.me: App ID và Khóa bí mật (secret key).
# Mỗi website tự cấp quyền OA cho ứng dụng này và dán refresh token trong Cài đặt website.
# Để trống thì tắt kênh Zalo OA.
ZALO_APP_ID=
ZALO_APP_SECRET=

# ---- Lưu trữ ảnh (S3-compatible: AWS S3, Cloudflare R2, MinIO, Viettel/VNPT/FPT Object Storage) ----
# Để trống S3_BUCKET thì ảnh được lưu trên đĩa tại UPLOADS_DIR và phục vụ qua /uploads/…
S3_BUCKET=
# Endpoint của nhà cung cấp, vd: https://<account-id>.r2.cloudflarestorage.com, http://minio:9000
# Để trống để dùng AWS S3 (https://s3.<S3_REGION>.amazonaws.com)
S3_ENDPOINT=
# Vùng lưu trữ (R2 dùng "auto"; MinIO thường là "us-east-1")
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# URL công khai để trình duyệt tải ảnh (CDN hoặc tên miền public của bucket), vd: https://cdn.hitechcloud.vn
# Để trống thì dùng URL của bucket trên endpoint (bucket cần cho phép đọc công khai)
S3_PUBLIC_URL=
# true: dạng <endpoint>/<bucket>/<key> (MinIO và nhiều nhà cung cấp trong nước); false: dạng <bucket>.<endpoint>/<key>
S3_FORCE_PATH_STYLE=false

# ---- Giám sát & vận hành ----
# Mức log: debug | info | warn | error | silent
LOG_LEVEL=info
# Định dạng log: json (mặc định khi NODE_ENV=production, phù hợp Loki/ELK) | pretty (dễ đọc khi phát triển)
LOG_FORMAT=json
# Token cho GET /metrics (Prometheus, header "Authorization: Bearer <token>"), chỉ phục vụ trên host của APP_URL.
# Để trống thì tắt /metrics. Tạo token: openssl rand -hex 32
METRICS_TOKEN=
# Webhook nhận cảnh báo lỗi 5xx / sự cố tiến trình (Slack incoming webhook hoặc Discord webhook, bắt buộc https).
# Mỗi loại lỗi gửi tối đa 1 lần/phút. Để trống thì chỉ ghi log.
ERROR_WEBHOOK_URL=
