{
	email {$ACME_EMAIL}
	# Certificates for customer domains and <sub>.PUBLISH_ROOT_DOMAIN are issued on
	# first request, only for hosts the app confirms it serves.
	on_demand_tls {
		ask http://app:3000/_htc/tls-ask
	}
}

